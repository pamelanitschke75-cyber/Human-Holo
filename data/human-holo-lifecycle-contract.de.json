  },
  "life_phases": [
    {
      "id": "setup",
      "title": "Beginn, Einrichtung und privater Import",
      "required": [
        "Eine neue persönliche Identität beginnt ohne Daten anderer Menschen.",
        "Ownerbindung wird vor persönlichem Zugriff geprüft.",
        "Private Importe werden ihrer Owneridentität zugeordnet, geprüft und ausdrücklich bestätigt.",
        "Originalquellen und daraus abgeleitete Inhalte bleiben getrennt."
      ]
    },
    {
      "id": "daily_development",
      "title": "Alltag und persönliche Entwicklung",
      "required": [
        "Ownergebundene Ereignisse können modalitätsübergreifend verknüpft werden.",
        "Quelle, Zeitpunkt, Korrekturhistorie und Verlässlichkeitsstatus bleiben nachvollziehbar.",
        "Die aktuelle eindeutige Ownerkorrektur hat im normalen Abruf Vorrang, ohne alte Angaben heimlich zu löschen.",
        "Proaktive Hilfe bleibt erklärbar, begrenzbar und abschaltbar."
      ]
    },
    {
      "id": "relationships",
      "title": "Beziehungen und gemeinsame Erlebnisse",
      "required": [
        "Zwischen Personen existiert kein gemeinsamer persönlicher Speicher.",
        "Gemeinsame Erlebnisse werden nur als getrennte, selbst bestätigte Ownerkopien gespeichert.",
        "Jede Ownerkopie bleibt unabhängig widerrufbar.",
        "Beziehung oder Nähe erzeugt keine Berechtigung."
      ]
    },
    {
      "id": "technology_change",
      "title": "Geräte-, App-, Server- und Anbieterwechsel",
      "required": [
        "Vollständige verschlüsselte Sicherung und überprüfte Wiederherstellung gehen einem Wechsel voraus.",
        "Ownertrennung, Quellen, Historie und Status bleiben bei Migration erhalten.",
        "Sicherheitsbindungen werden auf neuer Hardware bewusst neu eingerichtet.",
        "Ein Anbieterwechsel geschieht niemals still."
      ]
    },
    {
      "id": "aging_and_accessibility",
      "title": "Alter, Barrierefreiheit und veränderte Bedürfnisse",
      "required": [
        "Alter oder Behinderung werden nicht als fehlende Entscheidungsfähigkeit interpretiert.",
        "Gesprochene Sprache wird ohne feste Sprachliste automatisch erkannt und praktisch geprüft.",
        "Zugänglichkeit umfasst Sprach-, Vorlese-, Gebärdensprach-, visuelle, auditive, motorische und kognitive Wege.",
        "Human Holo unterstützt, ersetzt aber keine professionelle Versorgung."
      ]
    },
    {
      "id": "incapacity",
      "title": "Vorübergehende oder dauerhafte Einschränkung der Entscheidungsfähigkeit",
      "required": [
        "Human Holo diagnostiziert keine Entscheidungsfähigkeit.",
        "Ohne getrennte wirksame Ownerregel bleibt der persönliche Zugriff geschlossen.",
        "Eine Beziehung allein erzeugt keine Vertretungsbefugnis.",
        "Künftiger Notfallzugriff ist ownerdefiniert, minimal, zweckgebunden, zeitlich begrenzt und protokolliert."
      ]
    },
    {
      "id": "legacy",
      "title": "Tod, Erinnerung und Vermächtnis",
      "required": [
        "Es wird weder biologische Anwesenheit noch bewiesene Bewusstseinsfortsetzung behauptet.",
        "Ein Erinnerungsmodus ist transparent als datenbasierte Darstellung gekennzeichnet.",
        "Neue Wünsche oder Einwilligungen einer verstorbenen Person werden nicht erfunden.",
        "Ohne wirksame Ownerregel bleibt der persönliche Bestand geschlossen."
      ]
    },
    {
      "id": "pause_and_end",
      "title": "Pause, Widerruf und Ende",
      "required": [
        "Einzelne Einwilligungen und proaktive Funktionen bleiben getrennt widerrufbar.",
        "Vor vollständiger Beendigung wird soweit zulässig ein verständlicher Export angeboten.",
        "Vollständige Löschung benötigt eine authentifizierte, ausdrückliche Ownerbestätigung.",
        "Inaktivität, Geräteverlust, Abonnementende oder Fehler sind kein Löschauftrag."
      ]
    }
  ],
